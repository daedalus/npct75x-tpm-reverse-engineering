# Ignore binaries, evidence, and artifacts - only source code in repo
*.pe
*.bin
*.rom
*.zip
*.der
*.fd
*.img
*.log
*.tmp
*.swp
*.swo
*.DS_Store

# Python bytecode
__pycache__/
*.pyc
*.pyo

# System backup files
*.backup
*.bak

# Evidence and data artifacts (do NOT commit)
# probe --out / certs --out / nv --dump-dir output used in the README
out/

# Build directories
build/
dist/
*.egg
*.egg-info/

# Virtual environments
venv/
env/

# IDE files
.idea/
.vscode/
*.iml
*.code-workspace

# System swap files
*~
*.*~
